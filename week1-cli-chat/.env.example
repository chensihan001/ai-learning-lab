# 复制本文件为 .env，然后填入自己的 Key。.env 已在 .gitignore 里，不会被提交。
# DeepSeek：https://platform.deepseek.com/ 申请，充值几块钱够用到寒假
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat

# 想换通义千问（DashScope 兼容模式）时改成：
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL=qwen-plus
